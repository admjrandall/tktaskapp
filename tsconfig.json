{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@config/*": ["./config/*"],
      "@core/*": ["./packages/core/src/*"],
      "@adapter-null/*": ["./packages/adapter-null/src/*"],
      "@adapter-rxdb/*": ["./packages/adapter-rxdb/src/*"],
      "@adapter-dataverse/*": ["./packages/adapter-dataverse/src/*"],
      "@adapter-mobile-native/*": ["./packages/adapter-mobile-native/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/*.ts",
    "server/src/**/*.ts",
    "scripts/**/*.mjs",
    "config/**/*.ts",
    "playwright.config.ts",
    "vitest.shared.ts"
  ],
  "exclude": ["node_modules", "dist", "verifier", "_bmad", "originalfiles", "Coremdfiles"]
}

# ──────────────────────────────────────────────────────────────────────────────
# Local development environment file for docker-compose
#
# Copy this file to .env.local and fill in every value before running:
#   cp .env.local.example .env.local
#   docker compose up
#
# .env.local is in .gitignore — never commit it.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by both the postgres service (POSTGRES_PASSWORD) and the server
# (DATABASE_URL).  Change the password to anything you like for local dev.
POSTGRES_PASSWORD=changeme_local_dev_only

# Inside Docker Compose the server connects to the "postgres" service by name,
# not to localhost.  Use the same user/db as the postgres service definition.
DATABASE_URL=postgresql://tktaskapp:changeme_local_dev_only@postgres:5432/tktaskapp

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Azure Entra ID (OIDC / PKCE auth) ────────────────────────────────────────
# Create a "Web" platform app registration in the Microsoft Entra admin center:
#   https://entra.microsoft.com → Identity → Applications → App registrations
#
# Required settings in the registration:
#   Supported account types : Accounts in this organizational directory only
#   Platform                : Web
#   Redirect URI            : http://localhost:3000/auth/callback
#   Client secret           : Certificates & secrets → New client secret
#
# Paste the values here after creating the registration.
ENTRA_TENANT_ID=          # Directory (tenant) ID from the Overview tab
ENTRA_CLIENT_ID=          # Application (client) ID from the Overview tab
ENTRA_CLIENT_SECRET=      # Value (not ID) of the client secret you created

# Must match the redirect URI registered above exactly.
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Random 32-byte secret used to sign PKCE state cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow the Vite dev server (5173) and the server itself (3000).
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth state (PKCE, refresh tokens, access-token revocation) ────────────────
# Leave empty for local dev — falls back to an in-memory store.
# Required in staging/production (multi-instance or restart-safe revocation).
AUTH_STATE_REDIS_URL=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Points to the otel-collector service on the Docker bridge network.
# The collector forwards traces to Jaeger — view them at http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── OPA (policy engine) ───────────────────────────────────────────────────────
# Leave empty for local dev — falls back to the in-process TypeScript engine.
# Set to http://opa:8181 if you add an OPA sidecar to docker-compose.
OPA_URL=

# ── Enterprise SPA static serving ────────────────────────────────────────────
# Leave empty to run the Vite dev server separately (recommended for dev).
# Set to /app/dist/enterprise if you want the server to also serve the SPA.
ENTERPRISE_STATIC_DIR=

# ── KMS provider ─────────────────────────────────────────────────────────────
# Leave as azure for local dev.  Azure Key Vault calls will fail gracefully
# unless AZURE_KV_URL and credentials are also set.
KMS_PROVIDER=azure
AZURE_KV_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── AI Gateway ────────────────────────────────────────────────────────────────
AI_GATEWAY_MONTHLY_BUDGET_TOKENS=1000000
AI_GATEWAY_REDIS_URL=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

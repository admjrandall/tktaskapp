# Task App CRM — Environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to git.

# ── Turborepo Remote Cache ────────────────────────────────────────────────────
# Self-hosted S3-backed remote cache (ducktors/turborepo-remote-cache).
# Vercel's hosted cache is not used — all cache traffic stays on-prem.
# See docs/remote-cache-setup.md for deployment instructions.

# API token used to authenticate against the self-hosted cache server.
TURBO_TOKEN=replace-with-turbo-api-token

# Team/scope identifier that namespaces cached artifacts on the cache server.
TURBO_TEAM=tktaskapp

# Base URL of the self-hosted Turborepo cache server.
TURBO_API=https://cache.internal.example.com

# Opt out of Turborepo anonymous usage telemetry (recommended for air-gapped / private deployments).
TURBO_TELEMETRY_DISABLED=1

# ── Server ───────────────────────────────────────────────────────────────────
# HTTP port the server listens on inside the container
PORT=3000

# Node environment — controls logging verbosity and error detail
# Values: development | staging | production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://tktaskapp:changeme@localhost:5432/tktaskapp

# Postgres password (used by docker-compose to initialise the container)
POSTGRES_PASSWORD=changeme

# Maximum pool size for the Drizzle/pg connection pool
DATABASE_POOL_MAX=10

# ── Entra ID / OIDC Identity ─────────────────────────────────────────────────
# Microsoft Entra application/client ID registered for this application.
ENTRA_CLIENT_ID=replace-with-entra-application-client-id

# Microsoft Entra tenant ID. Use a concrete tenant ID in production.
ENTRA_TENANT_ID=replace-with-entra-tenant-id

# Redirect URI registered for the PKCE callback. Production must use HTTPS.
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ── KMS ──────────────────────────────────────────────────────────────────────
# KMS provider selection — azure (default) or aws
KMS_PROVIDER=azure

# Azure Key Vault URL when KMS_PROVIDER=azure
AZURE_KV_URL=https://your-vault.vault.azure.net

# AWS region when KMS_PROVIDER=aws
AWS_REGION=us-east-1

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# OTLP gRPC exporter endpoint — usually the OTel Collector sidecar
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Service name reported in all traces, metrics, and logs
OTEL_SERVICE_NAME=tktaskapp-server

# Service version — should match the version field in server/package.json
OTEL_SERVICE_VERSION=0.0.1

# Log level — values: debug | info | warn | error
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins permitted to make cross-origin requests.
# Wildcards are not supported — enumerate every allowed origin explicitly.
# For local development: http://localhost:5173,http://localhost:3000
# For production:        https://app.example.com,https://admin.example.com
ALLOW_ORIGINS=http://localhost:5173

# Additional enterprise Content-Security-Policy connect-src origins, if private
# Ollama or internal gateways are approved for the deployment.
# Wildcards are not supported.
ENTERPRISE_CSP_CONNECT_SRC=

# Set true only after the production domain satisfies HSTS preload requirements
# and the domain owner has approved preload-list submission.
SECURITY_HEADERS_HSTS_PRELOAD=false

# ── Session ──────────────────────────────────────────────────────────────────
# Durable auth state for PKCE, refresh-token replay detection, step-up tokens,
# access-token revocation, and one-time SSE stream tickets. Required in production.
AUTH_STATE_REDIS_URL=redis://localhost:6379/0

# ── AI Gateway (Phase 9+) ─────────────────────────────────────────────────────
# Durable rate/budget state for AI gateway policy enforcement. Required in production.
AI_GATEWAY_REDIS_URL=redis://localhost:6379/1

# Maximum tokens per AI request allowed by the policy engine
AI_GATEWAY_MAX_TOKENS=4096

# Allowed AI model identifiers (comma-separated) — enforced by the policy engine
AI_GATEWAY_ALLOWED_MODELS=gemini-nano,phi-4-mini

# ── Enterprise Web ───────────────────────────────────────────────────────────
# Same-origin is the default. Set this only when the enterprise frontend is
# hosted separately from the Hono server.
VITE_SERVER_URL=http://localhost:3000

# Hono serves dist/enterprise when this is set.
ENTERPRISE_STATIC_DIR=dist/enterprise

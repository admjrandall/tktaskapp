# Task App CRM — Environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to git.

# ── Server ───────────────────────────────────────────────────────────────────
# HTTP port the server listens on inside the container
PORT=3000

# Node environment — controls logging verbosity and error detail
# Values: development | staging | production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://tktaskapp:changeme@localhost:5432/tktaskapp

# Postgres password (used by docker-compose to initialise the container)
POSTGRES_PASSWORD=changeme

# Maximum pool size for the Drizzle/pg connection pool
DATABASE_POOL_MAX=10

# ── OIDC / Identity ──────────────────────────────────────────────────────────
# OIDC issuer URL — must be resolvable from the server at runtime
OIDC_ISSUER=https://your-idp.example.com

# Client ID registered at the IdP for this application
OIDC_CLIENT_ID=tktaskapp-server

# Client secret (confidential client) — treat as a high-value secret
OIDC_CLIENT_SECRET=replace-with-real-secret

# Redirect URI registered at the IdP for the PKCE callback
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Access token lifetime in seconds (must not exceed 900 — see server/src/auth/oidc.ts)
OIDC_ACCESS_TOKEN_TTL=900

# ── KMS ──────────────────────────────────────────────────────────────────────
# KMS service endpoint — used for per-user DEK/KEK lifecycle (Phase 6 design)
# Example for a self-hosted HashiCorp Vault: http://vault:8200
KMS_ENDPOINT=https://kms.example.com

# KMS API key / token used by the server to authenticate against the KMS
# Replace with a Vault token, AWS KMS key ARN, or Azure Key Vault credentials as appropriate
KMS_API_KEY=replace-with-real-kms-credential

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# OTLP gRPC exporter endpoint — usually the OTel Collector sidecar
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Service name reported in all traces, metrics, and logs
OTEL_SERVICE_NAME=tktaskapp-server

# Service version — should match the version field in server/package.json
OTEL_SERVICE_VERSION=0.0.1

# Log level — values: debug | info | warn | error
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-origin requests
# For local development: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ── Session ──────────────────────────────────────────────────────────────────
# Signing secret for server-side sessions — minimum 32 random bytes, base64-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes-base64url-encoded

# ── AI Gateway (Phase 9+) ─────────────────────────────────────────────────────
# Maximum tokens per AI request allowed by the policy engine
AI_GATEWAY_MAX_TOKENS=4096

# Allowed AI model identifiers (comma-separated) — enforced by the policy engine
AI_GATEWAY_ALLOWED_MODELS=gemini-nano,phi-4-mini

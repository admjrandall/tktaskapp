{
  "name": "@tktaskapp/server",
  "private": true,
  "version": "0.1.0",
  "description": "Task App CRM enterprise server — Hono v4, Drizzle ORM, PostgreSQL, OPA, OTel",
  "type": "module",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3",
    "@azure/identity": "^4",
    "@azure/keyvault-keys": "^4",
    "@hono/node-server": "^1",
    "@hono/swagger-ui": "^0.5.0",
    "@open-policy-agent/opa-wasm": "^1",
    "@opentelemetry/api": "^1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4",
    "hono-openapi": "^1.3.0",
    "ioredis": "^5",
    "jose": "^6.2.3",
    "pg": "^8",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "esbuild": "^0.28.0",
    "openapi-types": "^12.1.3",
    "tsx": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/server.js && esbuild src/db/migrate.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/migrate.js",
    "build:server": "pnpm run build",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:validate": "node ../scripts/validate-migrations.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run --passWithNoTests"
  }
}

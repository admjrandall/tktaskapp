# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/taskapp

# ── KMS provider selection ────────────────────────────────────────────────────
# KMS_PROVIDER=azure (default) or KMS_PROVIDER=aws
KMS_PROVIDER=azure

# ── Azure Key Vault (KMS_PROVIDER=azure) ─────────────────────────────────────
AZURE_KV_URL=https://your-vault.vault.azure.net
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── AWS KMS (KMS_PROVIDER=aws) ────────────────────────────────────────────────
# AWS credentials are read from the standard SDK chain (env, ~/.aws, IMDS).
AWS_REGION=us-east-1

# ── Entra ID (OIDC / auth) ────────────────────────────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Secret used to sign PKCE state cookies. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# ── Auth state (PKCE, refresh tokens, access-token revocation) ────────────────
# Required in production. Falls back to in-memory (dev/test only — not suitable for
# multi-instance deployments or surviving restarts).
AUTH_STATE_REDIS_URL=

# ── Enterprise SPA static serving ────────────────────────────────────────────
# Absolute or CWD-relative path to the built enterprise SPA (dist/enterprise/).
# Leave unset in development — the Vite dev server serves the frontend separately.
# Example (production, running node from repo root): ENTERPRISE_STATIC_DIR=./dist/enterprise
ENTERPRISE_STATIC_DIR=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards.
ALLOW_ORIGINS=http://localhost:5173

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── OPA (policy engine) ───────────────────────────────────────────────────────
# Optional — if set, uses OPA REST sidecar at this URL instead of WASM/in-process.
# Example: http://localhost:8181
OPA_URL=

# ── AI Gateway ────────────────────────────────────────────────────────────────
# Monthly token budget per tenant (default: 1,000,000)
AI_GATEWAY_MONTHLY_BUDGET_TOKENS=1000000
# Optional — if set, uses Redis for rate limiting and budget tracking (multi-instance).
# Also used as a fallback for AUTH_STATE_REDIS_URL if that is not set.
AI_GATEWAY_REDIS_URL=

# ── Server-side LLM clients (AI attribute compute) ───────────────────────────
# At least one key must be set for the ai-attributes endpoint to function.
# AI_PROVIDER selects the default provider when a model ID is ambiguous.
# Values: anthropic | openai | google
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

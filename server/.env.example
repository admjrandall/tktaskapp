# ── Turborepo Remote Cache ────────────────────────────────────────────────────
# Self-hosted S3-backed remote cache (ducktors/turborepo-remote-cache).
# Vercel's hosted cache is not used — all cache traffic stays on-prem.
# See docs/remote-cache-setup.md for deployment instructions.

# API token used to authenticate against the self-hosted cache server.
TURBO_TOKEN=replace-with-turbo-api-token

# Team/scope identifier that namespaces cached artifacts on the cache server.
TURBO_TEAM=tktaskapp

# Base URL of the self-hosted Turborepo cache server.
TURBO_API=https://cache.internal.example.com

# Opt out of Turborepo anonymous usage telemetry (recommended for air-gapped / private deployments).
TURBO_TELEMETRY_DISABLED=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/taskapp

# ── KMS provider selection ────────────────────────────────────────────────────
# KMS_PROVIDER=azure (default) or KMS_PROVIDER=aws
KMS_PROVIDER=azure

# ── Azure Key Vault (KMS_PROVIDER=azure) ─────────────────────────────────────
AZURE_KV_URL=https://your-vault.vault.azure.net
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── AWS KMS (KMS_PROVIDER=aws) ────────────────────────────────────────────────
# AWS credentials are read from the standard SDK chain (env, ~/.aws, IMDS).
AWS_REGION=us-east-1

# ── Entra ID (OIDC / auth) ────────────────────────────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Secret used to sign PKCE state cookies. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# ── Auth state (PKCE, refresh tokens, access-token revocation) ────────────────
# Required in production. Falls back to in-memory (dev/test only — not suitable for
# multi-instance deployments or surviving restarts).
AUTH_STATE_REDIS_URL=

# ── Enterprise SPA static serving ────────────────────────────────────────────
# Absolute or CWD-relative path to the built enterprise SPA (dist/enterprise/).
# Leave unset in development — the Vite dev server serves the frontend separately.
# Example (production, running node from repo root): ENTERPRISE_STATIC_DIR=./dist/enterprise
ENTERPRISE_STATIC_DIR=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards.
ALLOW_ORIGINS=http://localhost:5173

# ── HTTP rate limiting ────────────────────────────────────────────────────────
# Tiered limiters (global per-IP, strict per-IP on /auth/*, per-user on /api/v1/*,
# strict per-user on the audit export). Redis-backed when a URL is available
# (coordinated across instances), with an in-memory per-instance fallback. Fails
# OPEN to the in-memory limiter on a Redis outage (never hard-denies on a blip).
#
# Redis URL precedence: RATE_LIMIT_REDIS_URL > AUTH_STATE_REDIS_URL > AI_GATEWAY_REDIS_URL.
RATE_LIMIT_REDIS_URL=
# Set to false to disable all HTTP rate limiting (dev/test only).
RATE_LIMIT_ENABLED=true
# Number of trusted reverse-proxy hops in front of the app. 0 (default) ignores
# X-Forwarded-For and uses the socket address (spoofing-safe). Set to the real
# hop count (e.g. 1 behind a single nginx/ALB) so the client IP is read correctly.
TRUST_PROXY=0
# Per-tier overrides (requests / window-ms). Defaults shown.
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_MS=60000

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── OPA (policy engine) ───────────────────────────────────────────────────────
# Optional — if set, uses OPA REST sidecar at this URL instead of WASM/in-process.
# Example: http://localhost:8181
OPA_URL=

# ── AI Gateway ────────────────────────────────────────────────────────────────
# Monthly token budget per tenant (default: 1,000,000)
AI_GATEWAY_MONTHLY_BUDGET_TOKENS=1000000
# Optional — if set, uses Redis for rate limiting and budget tracking (multi-instance).
# Also used as a fallback for AUTH_STATE_REDIS_URL if that is not set.
AI_GATEWAY_REDIS_URL=

# ── Server-side LLM clients (AI attribute compute) ───────────────────────────
# At least one key must be set for the ai-attributes endpoint to function.
# AI_PROVIDER selects the default provider when a model ID is ambiguous.
# Values: anthropic | openai | google
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ── Email (notification:dispatch job — email channel) ─────────────────────────
# EMAIL_PROVIDER selects the outbound email provider.
# Values: aws-ses | smtp | none (default: none — logs only, safe for dev/CI)
EMAIL_PROVIDER=none

# EMAIL_PROVIDER=aws-ses — uses AWS SES v2 (shares AWS_REGION with KMS_PROVIDER=aws).
# Sending identity must be verified in SES before use.
# AWS credentials are read from the standard SDK chain (env, ~/.aws, IMDS).
EMAIL_FROM_ADDRESS=no-reply@example.com

# EMAIL_PROVIDER=smtp — uses SMTP via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# ── Turborepo (build infrastructure — not used at server runtime) ─────────────
# OTLP HTTP endpoint for Turborepo experimental task span export (Turborepo 2.9+).
# When set on CI runners, turbo task spans are exported to this OTLP endpoint.
TURBO_OTEL_TRACE_ENDPOINT=

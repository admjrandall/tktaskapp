{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["every weekend"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "groupName": "build-tooling",
      "matchPackageNames": ["vite", "vite-plugin-singlefile", "typescript", "turbo", "pnpm"],
      "automerge": false,
      "labels": ["build-tooling"]
    },
    {
      "matchDepTypes": ["dependencies"],
      "automerge": false
    }
  ],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10
}
